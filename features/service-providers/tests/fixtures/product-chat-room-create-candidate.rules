// Emulator-only product room creation candidate. NOT production rules.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /chats/{chatId} {
   allow create: if request.auth != null
    && request.resource.data.keys().hasAll(['participants','productId'])
    && request.resource.data.keys().hasOnly(['participants','productId','lastUpdated'])
    && request.resource.data.participants is list
    && request.resource.data.participants.size() == 2
    && request.resource.data.participants[0] is string
    && request.resource.data.participants[1] is string
    && request.resource.data.participants[0] != request.resource.data.participants[1]
    && request.auth.uid in request.resource.data.participants
    && request.resource.data.productId is string
    && exists(/databases/$(database)/documents/products/$(request.resource.data.productId))
    && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.sellerUid in request.resource.data.participants
    && request.auth.uid != get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.sellerUid
    && (!('lastUpdated' in request.resource.data) || request.resource.data.lastUpdated == request.time);
   allow read, update, delete: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
