// EMULATOR-ONLY security candidate. Never publish directly to production.
// Requires full live rules export, legacy chat schema audit and explicit approval.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function isParticipant(chatId) {
   return signedIn() && exists(/databases/$(database)/documents/chats/$(chatId))
    && get(/databases/$(database)/documents/chats/$(chatId)).data.participants is list
    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
  }
  match /chats/{chatId} {
   allow get: if signedIn() && resource.data.participants is list && request.auth.uid in resource.data.participants;
   allow list: if signedIn() && resource.data.participants is list && request.auth.uid in resource.data.participants;
   // Create/update/delete disabled pending legacy room shape and block audit.
   allow create, update, delete: if false;
   match /messages/{msgId} {
    allow get, list: if isParticipant(chatId);
    // Message writes disabled pending sender, ownership and block audit.
    allow create, update, delete: if false;
   }
  }
  match /{document=**} { allow read, write: if false; }
 }
}
