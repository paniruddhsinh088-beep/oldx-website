// Emulator-only typing indicator candidate. NOT deployable to live Firebase.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /chats/{chatId} {
   allow update: if request.auth != null
    && resource.data.participants is list
    && request.auth.uid in resource.data.participants
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['typing_' + request.auth.uid])
    && request.resource.data['typing_' + request.auth.uid] is bool;
   allow read, create, delete: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
