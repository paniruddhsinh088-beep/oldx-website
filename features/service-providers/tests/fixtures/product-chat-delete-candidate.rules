// Emulator-only candidate for legacy product chat delete controls. NOT production rules.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function participant(chatId) { return request.auth != null && exists(/databases/$(database)/documents/chats/$(chatId)) && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants; }
  match /chats/{chatId}/messages/{msgId} {
   allow get, list: if participant(chatId);
   allow update: if participant(chatId) && (
    (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
     && request.resource.data.hiddenFor is list
     && request.resource.data.hiddenFor.size() == resource.data.get('hiddenFor',[]).size() + 1
     && request.resource.data.hiddenFor.hasAll(resource.data.get('hiddenFor',[]))
     && request.auth.uid in request.resource.data.hiddenFor
     && !(request.auth.uid in resource.data.get('hiddenFor',[])))
    || (resource.data.senderUid == request.auth.uid
     && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedForEveryone','text','attachment'])
     && request.resource.data.deletedForEveryone == true
     && request.resource.data.text == ''
     && request.resource.data.attachment == null)
   );
   allow create, delete: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
