// Consolidated OLDX product-chat emulator candidate; NOT deployable to production.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function signedIn() { return request.auth != null; }
  function productRoom(chatId) { return exists(/databases/$(database)/documents/chats/$(chatId)) && get(/databases/$(database)/documents/chats/$(chatId)).data.keys().hasAll(['participants','productId']); }
  function roomParticipant(chatId) { return signedIn() && productRoom(chatId) && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants; }
  match /chats/{chatId} {
   allow get, list: if signedIn() && request.auth.uid in resource.data.participants;
   allow create: if signedIn()
    && request.resource.data.keys().hasAll(['participants','productId'])
    && request.resource.data.keys().hasOnly(['participants','productId','lastUpdated'])
    && request.resource.data.participants is list
    && request.resource.data.participants.size() == 2
    && request.resource.data.participants[0] is string
    && request.resource.data.participants[1] is string
    && request.resource.data.participants[0] != request.resource.data.participants[1]
    && request.auth.uid in request.resource.data.participants
    && request.resource.data.productId is string
    && exists(/databases/$(database)/documents/products/$(request.resource.data.productId))
    && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.sellerUid in request.resource.data.participants
    && request.auth.uid != get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.sellerUid
    && (!('lastUpdated' in request.resource.data) || request.resource.data.lastUpdated == request.time);
   allow update: if signedIn()
    && resource.data.participants is list
    && request.auth.uid in resource.data.participants
    && request.resource.data.participants == resource.data.participants
    && request.resource.data.productId == resource.data.productId
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastUpdated','typing_' + request.auth.uid])
    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastUpdated']) || request.resource.data.lastUpdated == request.time)
    && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['typing_' + request.auth.uid]) || request.resource.data['typing_' + request.auth.uid] is bool);
   allow delete: if false;
   match /messages/{msgId} {
    allow get, list: if roomParticipant(chatId);
    allow create: if roomParticipant(chatId)
     && request.resource.data.keys().hasAll(['senderUid','text','createdAt','status'])
     && request.resource.data.senderUid == request.auth.uid
     && request.resource.data.status == 'sent';
    allow update: if roomParticipant(chatId) && (
     (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
      && resource.data.status == 'sent' && request.resource.data.status == 'read'
      && resource.data.senderUid != request.auth.uid)
     || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
      && request.resource.data.hiddenFor is list
      && request.resource.data.hiddenFor.size() == resource.data.get('hiddenFor',[]).size() + 1
      && request.resource.data.hiddenFor.hasAll(resource.data.get('hiddenFor',[]))
      && request.auth.uid in request.resource.data.hiddenFor
      && !(request.auth.uid in resource.data.get('hiddenFor',[])))
     || (resource.data.senderUid == request.auth.uid
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deletedForEveryone','text','attachment'])
      && request.resource.data.deletedForEveryone == true
      && request.resource.data.text == '' && request.resource.data.attachment == null)
    );
    allow delete: if false;
   }
  }
  match /{document=**} { allow read, write: if false; }
 }
}
