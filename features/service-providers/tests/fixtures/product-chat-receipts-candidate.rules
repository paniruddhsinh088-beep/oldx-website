// Emulator-only candidate for legacy product chat messages. NOT deployable.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function participant(chatId) {
   return request.auth != null
    && exists(/databases/$(database)/documents/chats/$(chatId))
    && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
  }
  match /chats/{chatId}/messages/{msgId} {
   allow read: if participant(chatId);
   allow create: if participant(chatId)
    && request.resource.data.senderUid == request.auth.uid
    && request.resource.data.keys().hasAll(['senderUid','text','createdAt','status'])
    && request.resource.data.status == 'sent';
   allow update: if participant(chatId)
    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
    && resource.data.status == 'sent'
    && request.resource.data.status == 'read'
    && resource.data.senderUid != request.auth.uid;
   allow delete: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
