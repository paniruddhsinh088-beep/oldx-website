// Standalone emulator regression fixture, NEVER deploy.
// Demonstrates that a broad legacy allow ORs with restrictive service rules.
rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  match /chats/{chatId} {
   allow create: if request.auth != null;
  }
  match /chats/{chatId} {
   allow create: if false;
  }
  match /{document=**} { allow read, write: if false; }
 }
}
