rules_version = '2';
// ISOLATED EMULATOR CANDIDATE ONLY — never deploy over production rules.
service cloud.firestore {
  match /databases/{database}/documents {
    function signedInOwner(providerId) {
      return request.auth != null && request.auth.uid == providerId;
    }
    function validDraft() {
      return request.resource.data.keys().hasOnly([
        'ownerUid', 'displayName', 'serviceIds', 'cityId',
        'areaLabel', 'description', 'status', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.keys().hasAll([
        'ownerUid', 'displayName', 'serviceIds', 'cityId',
        'status', 'createdAt', 'updatedAt'
      ])
      && request.resource.data.ownerUid is string
      && request.resource.data.displayName is string
      && request.resource.data.displayName.size() >= 1
      && request.resource.data.displayName.size() <= 80
      && request.resource.data.serviceIds is list
      && request.resource.data.serviceIds.size() >= 1
      && request.resource.data.serviceIds.size() <= 8
      && request.resource.data.serviceIds.toSet().size() == request.resource.data.serviceIds.size()
      && request.resource.data.serviceIds[0] is string
      && request.resource.data.serviceIds[0].matches('^[a-z0-9][a-z0-9_-]{1,39}$')
      && (request.resource.data.serviceIds.size() <= 1 || (request.resource.data.serviceIds[1] is string && request.resource.data.serviceIds[1].matches('^[a-z0-9][a-z0-9_-]{1,39}$')))
      && (request.resource.data.serviceIds.size() <= 2 || (request.resource.data.serviceIds[2] is string && request.resource.data.serviceIds[2].matches('^[a-z0-9][a-z0-9_-]{1,39}$')))
      && (request.resource.data.serviceIds.size() <= 3 || (request.resource.data.serviceIds[3] is string && request.resource.data.serviceIds[3].matches('^[a-z0-9][a-z0-9_-]{1,39}$')))
      && (request.resource.data.serviceIds.size() <= 4 || (request.resource.data.serviceIds[4] is string && request.resource.data.serviceIds[4].matches('^[a-z0-9][a-z0-9_-]{1,39}$')))
      && (request.resource.data.serviceIds.size() <= 5 || (request.resource.data.serviceIds[5] is string && request.resource.data.serviceIds[5].matches('^[a-z0-9][a-z0-9_-]{1,39}$')))
      && (request.resource.data.serviceIds.size() <= 6 || (request.resource.data.serviceIds[6] is string && request.resource.data.serviceIds[6].matches('^[a-z0-9][a-z0-9_-]{1,39}$')))
      && (request.resource.data.serviceIds.size() <= 7 || (request.resource.data.serviceIds[7] is string && request.resource.data.serviceIds[7].matches('^[a-z0-9][a-z0-9_-]{1,39}$')))
      && request.resource.data.cityId is string
      && request.resource.data.cityId.matches('^[a-z0-9][a-z0-9_-]{1,39}$')
      && (!('areaLabel' in request.resource.data) ||
          (request.resource.data.areaLabel is string && request.resource.data.areaLabel.size() <= 100))
      && (!('description' in request.resource.data) ||
          (request.resource.data.description is string && request.resource.data.description.size() <= 1000));
    }
    match /serviceProviders/{providerId} {
      allow get: if resource.data.status == 'active' || signedInOwner(providerId);
      allow list: if resource.data.status == 'active'
        && request.query.limit != null && request.query.limit <= 20;
      allow create: if signedInOwner(providerId) && validDraft()
        && request.resource.data.ownerUid == providerId
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time;
      allow update: if signedInOwner(providerId)
        && resource.data.ownerUid == providerId && validDraft()
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.status == resource.data.status
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'displayName', 'serviceIds', 'cityId', 'areaLabel', 'description', 'updatedAt'
        ]);
      allow delete: if false;
    }
    match /serviceProviderPrivate/{providerId} {
      allow read, write: if false;
    }
    match /serviceProviderReviews/{reviewId} {
      allow get: if resource.data.status == 'published';
      allow list, create, update, delete: if false;
    }
    match /serviceProviderAudit/{eventId} {
      allow read, write: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
