{
  "name": "oldx-security-review",
  "version": "0.1.0",
  "private": true,
  "description": "Local safety checks for the OLDX security review branch",
  "scripts": {
    "test:emulator:safety": "node --test tests/firestore-emulator/safety.test.mjs tests/firestore-emulator/fixtures.test.mjs tests/firestore-emulator/firebase-config-safety.test.mjs tests/firestore-emulator/rules-baseline.test.mjs tests/firestore-emulator/deployment-boundary.test.mjs tests/firestore-emulator/profile-migration-transform.test.mjs tests/firestore-emulator/profile-access-policy-model.test.mjs tests/firestore-emulator/admin-authorization-model.test.mjs tests/firestore-emulator/xss-rendering-source.test.mjs tests/firestore-emulator/xss-product-detail-source.test.mjs tests/firestore-emulator/xss-product-card-cart-myads.test.mjs tests/firestore-emulator/xss-search-store-source.test.mjs tests/firestore-emulator/product-photo-removal-source.test.mjs tests/firestore-emulator/product-image-processing-source.test.mjs tests/storage-emulator/candidate-rules-source.test.mjs",
    "test:emulator:rules": "firebase emulators:exec --only firestore --project demo-oldx-emulator --config firebase.emulator.json \"node --test tests/firestore-emulator/rules-runtime.test.mjs tests/firestore-emulator/admin-atomic-audit.test.mjs\"",
    "test:profile-migration": "node --test tests/firestore-emulator/profile-migration-transform.test.mjs",
    "test:admin-backend": "node --test functions/admin-backend/*.test.mjs",
    "test:firebase-config": "node --test scripts/generate-firebase-env.test.js",
    "test:storage:rules": "firebase emulators:exec --only storage --project demo-oldx-storage --config firebase.storage-emulator.json \"node --test tests/storage-emulator/rules-runtime.test.mjs\""
  },
  "engines": {
    "node": ">=20"
  }
}
