{
  "name": "oldx-security-review",
  "version": "0.1.0",
  "private": true,
  "description": "Local safety checks for the OLDX security review branch",
  "scripts": {
    "test:emulator:safety": "node --test tests/firestore-emulator/*.test.mjs",
    "test:emulator:rules": "firebase emulators:exec --only firestore --project demo-oldx-emulator --config firebase.emulator.json \"node --test tests/firestore-emulator/rules-runtime.test.mjs\""
  },
  "engines": {
    "node": ">=20"
  }
}
